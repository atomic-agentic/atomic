{
  "name": "atomic-astro-authoring",
  "private": true,
  "type": "module",
  "imports": { "#astro-source-map": "./src/reference-source-map.mjs" },
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "probe:lsp": "node src/lsp-probe.mjs",
    "probe:format": "node src/format-probe.mjs",
    "probe:controls": "node src/control-probe.mjs",
    "probe:deno": "node src/deno-probe.mjs",
    "probe:contracts": "node src/contract-probe.mjs",
    "render": "node src/cli.mjs",
    "generate": "node src/generate.mjs",
    "check:types": "node src/generate.mjs --check",
    "pretest": "node src/generate.mjs",
    "preprobe:lsp": "node src/generate.mjs",
    "probe:generate": "node src/generation-probe.mjs",
    "probe:workspace": "node src/workspace-probe.mjs",
    "prerender": "node src/generate.mjs",
    "preprobe:contracts": "node src/generate.mjs",
    "probe:inferred": "node src/inferred-probe.mjs",
    "probe:config": "node src/config-probe.mjs",
    "preprobe:config": "node src/generate.mjs",
    "probe:boundaries": "deno run --no-config --no-lock --no-remote --allow-read=. --import-map=test/stubs/import-map.json test/context-boundary-probe.mjs",
    "probe:context": "node src/context-probe.mjs",
    "render:context": "node src/context-cli.mjs",
    "prerender:context": "node src/generate.mjs",
    "preprobe:context": "node src/generate.mjs",
    "build": "node src/build-worker.mjs"
  },
  "devDependencies": {
    "@astrojs/compiler": "4.0.0",
    "@astrojs/language-server": "2.17.3",
    "astro": "7.4.12",
    "esbuild": "0.27.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "5.9.3",
    "source-map-js": "1.2.2"
  }
}
