---
import type { Props, Input, Output } from '../.atomic/types/translate';
import type { AtomConfig } from '../.atomic/types/authoring';
const { input }: Props = Astro.props;
export const config: AtomConfig<Input, Output> = {
  "description": "Translate supplied public text through an approved remote agent.",
  "kind": "a2a",
  "remote": {
    "card": "https://translator.example.invalid/.well-known/agent-card.json",
    "skill": "translate"
  },
  "auth": {
    "secret": "translator-a2a-token"
  },
  "budget": {
    "minutes": 15
  },
  "validate": [({input, output}) => output.target === input.target]
};
---

Return the translated public text and the unchanged target language.
