both-streams-read-at-once|crates/atomic/tests/eval_cli.rs|    let said = read_on_a_thread(child.stdout.take().expect("stdout"));|    let said = { let (came, answer) = std::sync::mpsc::channel(); let mut pipe = child.stdout.take().expect("stdout"); let mut bytes = Vec::new(); let _ = pipe.read_to_end(&mut bytes); let _ = came.send(Ok(bytes)); answer }; // CONTROL_OFF: read in line, before anything reads the error stream|-p atomic-agentic --test eval_cli -- a_command_that_fills_one_stream_is_read_while_it_writes_the_other
