serve-line-names|crates/atomic/src/runs.rs|            Some(message) => atomic_app::panics::served(id, &message).log(),|            Some(message) => atomic_core::log_line!("atomic serve: run {}{}{}{}; {}{}{}", id, atomic_app::panics::PANICKED, message, atomic_app::panics::NOT_RETRIED, atomic_app::panics::HINT, id, atomic_app::panics::HINT_END), // CONTROL_OFF|-p atomic-agentic --features atomic-agentic/sandbox-tests --test run_cli serves_lines_name_a_run_called_for_a_secret_as_it_is
