---
import PolicyRules from './PolicyRules.astro';
import { effectiveApprovers } from '../../lib/review';
import type { Change } from '../../.atomic/types/schemas/change';
import type { Policy } from '../../.atomic/types/schemas/policy';
interface Props { policy: Policy; change: Change }
const { policy, change }: Props = Astro.props;
const approvers = effectiveApprovers(change, policy);
---
<PolicyRules policy={policy} approvers={approvers} />
Regional reviewers supplement baseline reviewers. They never replace them.
